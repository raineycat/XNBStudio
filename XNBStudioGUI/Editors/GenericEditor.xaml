<UserControl x:Class="XNBStudioGUI.Editors.GenericEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xnbs="clr-namespace:XNBStudioGUI"
             xmlns:xnbse="clr-namespace:XNBStudioGUI.Editors"
             xmlns:hex="clr-namespace:Spooksoft.HexEditor.Controls;assembly=Spooksoft.HexEditor"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance xnbse:GenericEditor}">
    <Grid>
        <!--<hex:HexEditorDisplay x:Name="FileContentHexEditor" IsReadOnly="True"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />-->
        <TextBlock Text="{Binding File.Data.Contents.Length, StringFormat=[{0} bytes]}" />
    </Grid>
</UserControl>
