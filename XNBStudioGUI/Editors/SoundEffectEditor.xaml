<UserControl x:Class="XNBStudioGUI.Editors.SoundEffectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xnbs="clr-namespace:XNBStudioGUI"
             xmlns:xnbse="clr-namespace:XNBStudioGUI.Editors"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance xnbse:SoundEffectEditor}">
    <UserControl.Resources>
        <xnbs:ImageBindingConverter x:Key="ImageBindingConverterRes" />
        <BitmapImage x:Key="WaveformFallbackImage" UriSource="/Resources/SoundWaveIcon.png" />
    </UserControl.Resources>
    
    <UserControl.CommandBindings>
        <CommandBinding Command="Play" Executed="ExecutePlayCommand" CanExecute="CanExecuteIfSoundLoaded" />
        <CommandBinding Command="Stop" Executed="ExecuteStopCommand" />
        <CommandBinding Command="Print" Executed="ExecutePrintCommand" CanExecute="CanExecuteIfSoundLoaded" />
    </UserControl.CommandBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0">
            <TextBlock.Text>
                <MultiBinding StringFormat="SoundEffect ({1}): {0}">
                    <Binding Path="Sound.WaveFormat" FallbackValue="???" />
                    <Binding Path="Sound.Duration" FallbackValue="?" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        
        <Image Grid.Row="1" 
               x:Name="WaveFormDisplay"
               Source="{StaticResource WaveformFallbackImage}" 
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </StackPanel.Resources>
            
            <Button Command="Play">
                Play 
            </Button>
            <Button Command="Stop">
                Stop
            </Button>
            <Button Command="Print">
                Export WAV  
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
