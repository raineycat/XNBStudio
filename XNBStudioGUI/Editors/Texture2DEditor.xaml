<UserControl x:Class="XNBStudioGUI.Editors.Texture2DEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xnbs="clr-namespace:XNBStudioGUI"
             xmlns:xnbse="clr-namespace:XNBStudioGUI.Editors"
             xmlns:is="clr-namespace:SixLabors.ImageSharp;assembly=SixLabors.ImageSharp"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance xnbse:Texture2DEditor}">
    <UserControl.Resources>
        <xnbs:ImageBindingConverter x:Key="ImageBindingConverterRes" />
        <xnbs:OpacityToColorConverter x:Key="ColorConverter" />
    </UserControl.Resources>
    
    <UserControl.CommandBindings>
        <CommandBinding Command="Print" Executed="ExecutePrintCommand" CanExecute="CanExecuteIfPreviewLoaded" />
    </UserControl.CommandBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0">
            <TextBlock.Text>
                <MultiBinding StringFormat="Texture2D ({3}): {0}x{1} ({2} mips)">
                    <Binding Path="Texture.Width" FallbackValue="?" />
                    <Binding Path="Texture.Height" FallbackValue="?" />
                    <Binding Path="Texture.Mips.Count" FallbackValue="0" />
                    <Binding Path="Texture.Format" FallbackValue="???" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        
        <Grid Grid.Row="1" x:Name="TextureDataDisplay" Background="{DynamicResource BackgroundBrush}">
            <Grid.Resources>
                <SolidColorBrush x:Key="BackgroundBrush" 
                                 Color="{Binding BackgroundOpacity, Converter={StaticResource ColorConverter}}" />
            </Grid.Resources>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <ListView Grid.Column="0" ItemsSource="{Binding Texture.Mips}" SelectionChanged="HandlePreviewImageSelected">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type is:Image}">
                        <StackPanel Orientation="Vertical">
                            <Image Width="64" Source="{Binding ., Converter={StaticResource ImageBindingConverterRes}}" />
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}x{1}">
                                        <Binding Path="Width" />
                                        <Binding Path="Height" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            
            <Image Grid.Column="2" 
                   Source="{Binding PreviewImage, Converter={StaticResource ImageBindingConverterRes}}"
                   Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
        
        <xnbs:StackTraceViewer Grid.Row="1" 
                               x:Name="ImageError" 
                               Visibility="Hidden"
                               TitleText="Failed to load the image!" />
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="5" Command="Print">Export to PNG</Button>
            
            <Slider Value="{Binding BackgroundOpacity}"
                    ToolTip="Background opacity"
                    Minimum="0"
                    Interval="5"
                    Maximum="100"
                    MinWidth="100"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
        </StackPanel>
    </Grid>
</UserControl>
