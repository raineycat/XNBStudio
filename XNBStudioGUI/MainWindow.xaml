<Window x:Class="XNBStudioGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xnbs="clr-namespace:XNBStudioGUI"
        mc:Ignorable="d"
        Title="XNB Studio GUI" Width="800" Height="450" d:DataContext="{d:DesignInstance xnbs:MainWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="ExecuteOpenCommand" />
        <CommandBinding Command="Help" Executed="ExecuteHelpCommand" />
        <CommandBinding Command="Close" Executed="ExecuteCloseCommand" />
        
        <CommandBinding Command="xnbs:StudioCommands.CloseFile" 
                        Executed="ExecuteCloseFileCommand" 
                        CanExecute="CanExecuteWhenFileSelected" />   
        
        <CommandBinding Command="xnbs:StudioCommands.CloseAllFiles" 
                        Executed="ExecuteCloseAllFilesCommand" 
                        CanExecute="CanExecuteWhenFilesLoaded" />        
    </Window.CommandBindings>
    
    <Window.Resources>
        <Style x:Key="FileListIconStyle" TargetType="Image">
            <Setter Property="Source" Value="Resources/DocumentError.png" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter Property="Source" Value="Resources/DocumentOK.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="InfoPanelStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding .}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open" Command="Open" />
                <MenuItem Header="Close" Command="xnbs:StudioCommands.CloseFile" />
                <MenuItem Header="Close all" Command="xnbs:StudioCommands.CloseAllFiles" />
                <Separator />
                <MenuItem Header="Help" Command="Help" />
                <MenuItem Header="Quit" Command="Close" />
            </MenuItem>
        </Menu>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ListView Grid.Column="0" 
                      ItemsSource="{Binding LoadedFiles}" 
                      SelectionChanged="HandleFileSelectionChanged"
                      x:Name="LoadedFileList"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type xnbs:LoadedFile}">
                        <StackPanel Orientation="Horizontal">
                            <Image Height="16" Style="{StaticResource FileListIconStyle}" />
                            <TextBlock Margin="10,0,0,0" Text="{Binding FileName}"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <DockPanel x:Name="ContentPanel"                      
                        Grid.Column="2"                            
                        DataContext="{Binding SelectedFile}"  
                        Margin="3"
                        Style="{StaticResource InfoPanelStyle}">
                <Expander DockPanel.Dock="Top" Header="Detailed info...">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding FilePath, FallbackValue=No file loaded!}" />
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Platform: {0};   Flags: {1};   Version: {2};   SharedRes: {3}">
                                    <Binding Path="Data.Platform" />
                                    <Binding Path="Data.Flags" />
                                    <Binding Path="Data.Version" />
                                    <Binding Path="Data.SharedResourceCount" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Separator />
                        <TextBlock>Type readers:</TextBlock>
                        <ListView ItemsSource="{Binding Data.TypeReaders}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} (v{1})">
                                                <Binding Path="Key" />
                                                <Binding Path="Value" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
                <Separator DockPanel.Dock="Top" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
