<UserControl x:Class="XNBStudioGUI.StackTraceViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xnbs="clr-namespace:XNBStudioGUI"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="300"
             d:DataContext="{d:DesignInstance xnbs:StackTraceViewer, IsDesignTimeCreatable=True}">
    <StackPanel>
        <TextBlock Text="{Binding TitleText}" FontSize="20" Foreground="DarkRed" />
        <TextBlock FontSize="15" TextWrapping="Wrap">
            <Run Text="{Binding ExceptionTypeName, Mode=OneWay}" />
            <Run Text=": " />
            <Run Text="{Binding ExceptionMessage, Mode=OneWay}" />
        </TextBlock>
        <Separator />
        <TextBlock Text="{Binding ExceptionStackTrace}" />
    </StackPanel>
</UserControl>
